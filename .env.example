PORT=8080
PUBLIC_URL=https://example.com
ALLOWED_ORIGINS=https://example.com
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

PRE_LAUNCH_MODE=true

# Optional idempotent market bootstrap used by the PostgreSQL HTTP runtime.
BOOTSTRAP_MARKET_CODE=KZ-ALA
BOOTSTRAP_MARKET_COUNTRY=KZ
BOOTSTRAP_MARKET_CITY=almaty
BOOTSTRAP_MARKET_NAME=Алматы
BOOTSTRAP_MARKET_TIMEZONE=Asia/Almaty
BOOTSTRAP_MARKET_CURRENCY=KZT
BOOTSTRAP_MARKET_LANGUAGE=ru-KZ
BOOTSTRAP_MARKET_LANGUAGES=ru-KZ,kk-KZ
BOOTSTRAP_MARKET_REGISTRATION_OPEN=true
BOOTSTRAP_MARKET_MATCHING_OPEN=false

# Legacy rollback-only settings.
MATCH_DATA_DIR=/app/data
ADMIN_IMPORT_KEY=replace-with-a-long-random-secret

OPENAI_API_KEY=
OPENAI_MODEL=
