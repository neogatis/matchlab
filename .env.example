PORT=8080
PUBLIC_URL=https://example.com
ALLOWED_ORIGINS=https://example.com
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

PRE_LAUNCH_MODE=true

# Private S3-compatible profile photo storage (Neon Object Storage in production).
MATCH_PHOTO_BUCKET=matchlab-profile-photos
AWS_ENDPOINT_URL_S3=https://storage.example.com
AWS_REGION=auto
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me


# Optional idempotent market bootstrap used by the PostgreSQL HTTP runtime.
BOOTSTRAP_MARKET_CODE=KZ-ALA
BOOTSTRAP_MARKET_COUNTRY=KZ
BOOTSTRAP_MARKET_CITY=almaty
BOOTSTRAP_MARKET_NAME=Алматы
BOOTSTRAP_MARKET_TIMEZONE=Asia/Almaty
BOOTSTRAP_MARKET_CURRENCY=KZT
BOOTSTRAP_MARKET_LANGUAGE=ru-KZ
BOOTSTRAP_MARKET_LANGUAGES=ru-KZ,kk-KZ
BOOTSTRAP_MARKET_REGISTRATION_OPEN=true
BOOTSTRAP_MARKET_MATCHING_OPEN=false

# Legacy rollback-only settings.
MATCH_DATA_DIR=/app/data
ADMIN_IMPORT_KEY=replace-with-a-long-random-secret

OPENAI_API_KEY=
OPENAI_MODEL=

# Phase 27 authentication providers.
# Phone OTP provider (Twilio). Use either TWILIO_FROM_NUMBER or Messaging Service SID.
SMS_PROVIDER=mobizon
MOBIZON_API_KEY=
MOBIZON_SENDER=
MOBIZON_API_BASE=https://api.mobizon.kz

# Optional fallback provider.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Native OIDC audiences used to verify Google/Apple ID tokens.
# Google mobile clients should request an ID token for this Web/server OAuth client.
GOOGLE_SERVER_CLIENT_ID=
# Optional extra accepted audiences / backward-compatible aliases.
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_ID=

# Native iOS Apple audience is normally the iOS bundle ID.
# Multiple values are comma-separated when a Services ID is added for web/Android.
APPLE_CLIENT_IDS=com.neogatis.matchlab
APPLE_CLIENT_ID=


# Optional email password-recovery delivery.
# Phone/SMS password recovery works independently through the configured SMS provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
